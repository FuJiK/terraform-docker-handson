# Copy to terraform.tfvars, then replace these fields.
# Actual trusted client public IPv4, in /32 notation:
admin_cidr           = "203.0.113.10/32"
# Existing EC2 SSH key pair name in ap-northeast-1:
ssh_key_name         = "REPLACE_WITH_KEY_PAIR_NAME"

enable_wordpress_lab = true
aws_region           = "ap-northeast-1"
project              = "aws-network-lab"
environment          = "dev"
vpc_cidr             = "10.40.0.0/16"
availability_zones   = ["ap-northeast-1a", "ap-northeast-1c"]
public_subnet_cidrs  = ["10.40.0.0/24", "10.40.1.0/24"]
private_subnet_cidrs = ["10.40.10.0/24", "10.40.11.0/24"]
instance_type        = "t3.micro"
root_volume_size_gib = 12
